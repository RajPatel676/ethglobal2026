# ───────────── Shared ─────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
HEDERA_JSON_RPC=https://testnet.hashio.io/api
HEDERA_MIRROR=https://testnet.mirrornode.hedera.com/api/v1

# ───────────── Sepolia keys ─────────────
# Deployer of VerificationConsumer / registry / resolver (also owns receivable.eth)
DEPLOYER_PRIVATE_KEY=0x
# Hedera adapter's Sepolia key: may write ONLY ats-token / hcs-seq / status records
ADAPTER_SEPOLIA_PRIVATE_KEY=0x
# Key that signs CRE HTTP trigger requests (authorizedKeys in workflow config)
TRIGGER_SIGNER_PRIVATE_KEY=0x

# ───────────── Sepolia deploy scripts (contracts/sepolia/script) ─────────────
# 01_RegisterName: commit/reveal salt. MUST be identical across the commit() and register()
# invocations. Anyone who learns it before you reveal can front-run the registration.
ENS_REGISTRATION_SECRET=change-me-before-registering
# 03_DeployConsumer: CRE workflow owner allowed to deliver reports. Leave blank for simulation;
# set it before the public demo or the consumer accepts reports from ANY workflow owner.
CRE_WORKFLOW_OWNER=
# 03_DeployConsumer: Hedera adapter's Sepolia address (Step 4). Blank -> setHederaAdapter() later.
HEDERA_ADAPTER_EVM_ADDRESS=
# Contract verification (foundry.toml [etherscan])
ETHERSCAN_API_KEY=

# ───────────── Hedera testnet ─────────────
HEDERA_ADAPTER_ACCOUNT_ID=0.0.
HEDERA_ADAPTER_PRIVATE_KEY=0x          # ECDSA (secp256k1) hex
HEDERA_ESCROW_ACCOUNT_ID=0.0.
HEDERA_ESCROW_PRIVATE_KEY=0x
HCS_REGISTRY_TOPIC_ID=0.0.

# ───────────── Mock accounting API ─────────────
MOCK_ACCOUNTING_URL=http://localhost:4100
MOCK_ACCOUNTING_TOKEN=demo-xero-token-change-me

# ───────────── Web ─────────────
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_HEDERA_JSON_RPC=https://testnet.hashio.io/api
NEXT_PUBLIC_HEDERA_MIRROR=https://testnet.mirrornode.hedera.com/api/v1
ADAPTER_URL=http://localhost:4200
ADAPTER_API_KEY=change-me

{
  "name": "receivable",
  "private": true,
  "version": "0.1.0",
  "description": "Verified, tokenized invoice financing for small businesses — ETHOnline 2026",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter web dev",
    "dev:adapter": "pnpm --filter adapter dev",
    "dev:mock": "pnpm --filter mock-accounting dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "forge:test": "forge test --root contracts/sepolia && forge test --root contracts/hedera",
    "abis": "tsx scripts/export-abis.ts",
    "ens:check": "tsx scripts/ens-check.ts",
    "hedera:setup": "tsx scripts/setup-hedera.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "cre:simulate": "bash services/cre/verify-invoice/scripts/simulate.sh",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,sol}\""
  },
  "devDependencies": {
    "@receivable/config": "workspace:*",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}

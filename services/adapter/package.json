{
  "name": "adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watches Sepolia for DON-verified invoices, mirrors each to Hedera (HCS registry + ATS bond + primary market), and writes the results back to ENS.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "settle": "tsx src/maturity/settle.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.62.0",
    "@hono/node-server": "^1.13.1",
    "@receivable/shared": "workspace:*",
    "hono": "^4.6.3",
    "viem": "^2.21.19",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@receivable/config": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
